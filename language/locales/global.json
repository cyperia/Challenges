{
  "symbol": {
    "arrow-back": "«",
    "arrow": "»",
    "chevron": "›",
    "chevron-back": "‹",
    "dart": "→",
    "vertical": "┃",
    "cross": "✞",
    "check": "✔",
    "x": "✘",
    "heart": "❤",
    "dot": "•",
    "circle": "●",
    "altert": "⚠",
    "flag": "⚐",
    "infinity": "∞",
    "lock": "🔒",
    "plus-minus": "±",
    "square": "■"
  },
  "arg-format": {
    "delimiter": "<dark_gray>, </dark_gray>",
    "delimiter_big": "<dark_gray> {@symbol.dot} </dark_gray>",
    "delimiter_space": "<gray> </gray>",
    "brackets": "<dark_gray>(<gray>{0}</gray>)</dark_gray>",
    "brackets_arg": "<gray>{0}</gray> {@brackets('{1}')}",
    "remaining": " <gray><i>+{0}</i></gray>",
    "hp-short": "<yellow>{0}</yellow> <gray>HP</gray>",
    "hp": "{@hp-short} <dark_gray>(<red>{1} {@symbol.heart}</red>)</dark_gray>",
    "hearts": "<red>{0} {@symbol.heart}</red>",
    "damage-cause": "<yellow>{0}</yellow>",
    "damage-cause-source": "<yellow>{0}</yellow> <dark_gray>(<gray>{1}</gray>)</dark_gray>",
    "time": "<yellow>{0}</yellow> <gray>{1}</gray>",
    "time-range": "{@time} <dark_gray>{@symbol.plus-minus}</dark_gray> {@time('{2}', '{3}')}",
    "radius": "<yellow>{0}</yellow> <gray>{1}</gray>",
    "percent": "<yellow>{0}%</yellow>"
  },
  "prefix": {
    "format": "<dark_gray><b>{@symbol.vertical}</b> {0} {@symbol.vertical}</dark_gray> ",
    "challenges": {
      "*colorize*": "<gradient:#5B3FE4:#8A3FCF>{0}</gradient>"
    },
    "timer": {
      "*colorize*": "<dark_purple>{0}</dark_purple>"
    },
    "backpack": {
      "*colorize*": "<green>{0}</green>"
    },
    "position": {
      "*colorize*": "<blue>{0}</blue>"
    },
    "damage": {
      "*colorize*": "<red>{0}</red>"
    },
    "custom": {
      "*colorize*": "<aqua>{0}</aqua>"
    },
    "quiz": {
      "*colorize*": "<yellow>{0}</yellow>"
    }
  },
  "actionbar": {
    "format": "<dark_gray>{@symbol.dot}</dark_gray> <gray>{0}</gray> <dark_gray>{@symbol.dot}</dark_gray>",
    "format-arg": "<dark_gray>{@symbol.dot}</dark_gray> <gray>{0}</gray> <dark_gray>{@symbol.vertical}</dark_gray> <gray>{1}</gray> <dark_gray>{@symbol.dot}</dark_gray>"
  },
  "bossbar": {
    "format": "<dark_gray>{@symbol.arrow}</dark_gray> <gray>{0}</gray>",
    "format-arg": "{@format} <dark_gray>{@symbol.vertical}</dark_gray> <gray>{1}</gray>"
  },
  "scoreboard": {
    "title-format": "<dark_gray>{@symbol.arrow}</dark_gray> <white><b>{0}</b></white>",
    "title": "{@title-format('Challenges')}",
    "leaderboard": {
      "entry": "<yellow>{0}</yellow> <dark_gray>{@symbol.vertical}</dark_gray> <gray>{1}</gray> <dark_gray>{@symbol.arrow}</dark_gray> <yellow>{2}</yellow>",
      "entry-detail": "{@entry} <dark_gray>{@symbol.vertical}</dark_gray> <gray>{3}</gray>"
    }
  },
  "hotbar": {
    "format": "{0} <dark_gray>{@symbol.vertical}</dark_gray> <yellow>{1}</yellow>",
    "timer": {
      "*colorize*": "<dark_purple>{0}</dark_purple>",
      "name": "{@format('*{@menu.timer.menu}*', '/timer')}"
    },
    "challenges": {
      "*colorize*": "<red>{0}</red>",
      "name": "{@format('*{@menu.challenges.menu}*', '/challenges')}"
    },
    "start": {
      "*colorize*": "<green>{0}</green>",
      "name": "{@format('*{@label}*', '/start')}"
    },
    "teams": {
      "*colorize*": "<color:#5983ba>{0}</color>",
      "name": "{@format('*{@label}*', '{@suffix.coming_soon}')}"
    }
  },
  "suffix": {
    "selected": "<dark_green><b>{@symbol.check}</b></dark_green>",
    "unselected": "<dark_red><b>{@symbol.x}</b></dark_red>",
    "new.*colorize*": "<b><gradient:#0BC418:#5CFC60>{0}!</gradient></b>",
    "new-count.*colorize*": "{@new.*colorize*}",
    "updated.*colorize*": "<b><gradient:#FFEE00:#C7FC4A>{0}!</gradient></b>",
    "updated-count.*colorize*": "{@updated.*colorize*}",
    "beta.*colorize*": "<b><gradient:#9B8CFF:#5B3FE4>{0}</gradient></b>",
    "beta-count.*colorize*": "{@beta.*colorize*}",
    "coming_soon.*colorize*": "<red>{0}</red>"
  },
  "timer": {
    "bar": {
      "up.*colorize*": "<gradient:#5B3FE4:#8A3FCF:{1}><b>{0}</b></gradient>",
      "down.*colorize*": "<gradient:#55FFFF:#0088CC:{1}><b>{0}</b></gradient>",
      "paused.*colorize*": "<gradient:#FF5555:#AA0000:{1}><b>{0}</b></gradient>",
      "countdown.*colorize*": "<gradient:#FF5555:#AA0000:{1}><b>{0}</b></gradient>",
      "format": "{@actionbar.format}"
    },
    "time": {
      "format": {
        "seconds": "{mm}:{ss}",
        "minutes": "{mm}:{ss}",
        "hours": "{hh}:{mm}:{ss}",
        "day": "{d} {@generic.day} {hh}:{mm}:{ss}",
        "days": "{d} {@generic.days} {hh}:{mm}:{ss}"
      }
    }
  },
  "command": {
    "invsee": {
      "title": "{@menu.title-format}"
    }
  },
  "menu": {
    "locked": {
      "*colorize*": "<color:#9B8CFF>{0}</color>",
      "title": {
        "*colorize*": "<b><gradient:#9B8CFF:#5B3FE4>{0}</gradient></b>"
      },
      "join": {
        "*colorize*": "<green>{0}</green>"
      },
      "cancel": {
        "*colorize*": "<red>{0}</red>"
      }
    },
    "generic": {
      "format": {
        "name": "<dark_gray>{@symbol.arrow}</dark_gray> <gray>{0}</gray>",
        "name_hotbar": "<dark_gray>{@symbol.dot}</dark_gray> {0} <dark_gray>{@symbol.dot}</dark_gray>",
        "desc": [
          " ",
          "<gray>{0}</gray>"
        ],
        "state": [
          " ",
          "<gray>{0}</gray>"
        ],
        "tooltip": [
          " ",
          "{0}"
        ],
        "suffix": " <dark_gray>{@symbol.vertical}</dark_gray> <gray>{0}</gray>",
        "suffix_delimiter": "{@arg-format.delimiter_space}"
      },
      "tooltip": {
        "format": "<gray>{0}</gray> <dark_gray>{@symbol.vertical}</dark_gray> <gray>{1}</gray>"
      }
    },
    "title-prefix": "<dark_gray>{@symbol.arrow}</dark_gray> ",
    "title-delimiter": " <dark_gray>{@symbol.vertical}</dark_gray> ",
    "title-colored": "<blue>{0}</blue>",
